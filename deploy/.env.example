# Copy to deploy/.env (chmod 600) and fill in. NEVER commit the real file.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=pos.example.com,backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://pos.example.com
PUBLIC_BASE_URL=https://pos.example.com
CORS_ALLOWED_ORIGINS=https://pos.example.com

# Fernet key(s) encrypting integration credentials at rest. The first key encrypts; all keys decrypt
# (prepend a new key to rotate). Generate:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

POSTGRES_DB=pizza
POSTGRES_USER=pizza
POSTGRES_PASSWORD=
# Option A (single instance): postgres     Option B (two instances): private IP of the DB instance
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Option A: redis://redis:6379/0     Option B: redis://:REDIS_PASSWORD@<db-private-ip>:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

LOG_LEVEL=INFO

# Database backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=21600
# Optional off-instance copy (S3 bucket via the instance role; S3 is object storage, not a database service)
BACKUP_S3_URI=
