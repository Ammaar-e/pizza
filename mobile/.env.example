# Copy to .env (never commit .env). Values are baked into the app at build/start time
# and can also be changed on the device in Settings.
EXPO_PUBLIC_PIZZA_API_URL=https://pos.amrt.ca
EXPO_PUBLIC_BBPOS_API_URL=https://pos-api.example.com
# Development only: allow http:// to LAN servers on Android
ALLOW_CLEARTEXT=false
# Installed app name / bundle identifier (must be unique per Apple/Google account)
APP_DISPLAY_NAME=Pizza POS
APP_BUNDLE_ID=com.example.pizzapos
# From `npx eas-cli init` (needed for EAS cloud builds)
EAS_PROJECT_ID=
EAS_OWNER=
